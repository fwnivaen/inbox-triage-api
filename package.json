{
  "name": "inbox-triage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smart Inbox Triage API — classifies incoming email into labels/priorities and assembles a daily digest, built on Cloudflare Workers + Workers AI.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretest": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "sample-digest": "tsx scripts/sample-digest.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
